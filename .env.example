# Never commit a real token. Generate one with: openssl rand -hex 32
ASR_API_TOKEN=replace-with-a-random-64-character-hex-token

HOME=/tmp/container-home
HF_HOME=/workspace/cache/huggingface
TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
TOKENIZERS_PARALLELISM=false
PYTHONPATH=/workspace/workspace

PARAKEET_MODEL_PATH=/workspace/cache/huggingface/hub/models--nvidia--parakeet-ctc-0.6b-Vietnamese/snapshots/REVISION/parakeet-ctc-0.6b-vi.nemo
PARAKEET_ENGINE_PATH=/workspace/engines/parakeet_ctc_vi_fp16_trt1011.engine
ASR_TEMP_DIR=/workspace/api_tmp
